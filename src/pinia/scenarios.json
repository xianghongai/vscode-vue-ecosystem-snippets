{
  "Pinia Setup (main entry)": {
    "prefix": ["pinia", "cp"],
    "body": [
      "import { createApp } from 'vue';",
      "import { createPinia } from 'pinia';",
      "import App from './App.vue';",
      "",
      "const pinia = createPinia();",
      "const app = createApp(App);",
      "",
      "app.use(pinia);",
      "app.mount('${1:#app}');"
    ],
    "description": "Application entry: create the pinia instance (the root store) and install it.\nRegister pinia plugins with `pinia.use(...)` before `app.use(pinia)`.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia Setup Store (full file)": {
    "prefix": ["defineStore", "ds"],
    "body": [
      "import { computed, ref } from 'vue';",
      "import { acceptHMRUpdate, defineStore } from 'pinia';",
      "",
      "export const use${1:${TM_FILENAME_BASE/[-_\\s]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/upcase}$2/g}}Store = defineStore('${2:${TM_FILENAME_BASE/^([A-Z])|(?<=[a-z0-9])([A-Z])|([-_\\s]+)/${1:/downcase}${2:+-}${2:/downcase}${3:+-}/g}}', () => {",
      "\t// state",
      "\tconst ${3:count} = ref(${4:0});",
      "",
      "\t// getters",
      "\tconst ${5:double} = computed(() => ${3}.value * 2);",
      "",
      "\t// actions",
      "\tfunction ${6:increment}(step = 1) {",
      "\t\t${3}.value += step;",
      "\t}",
      "",
      "\t// Setup Stores have no built-in \\$reset(), define your own",
      "\tfunction \\$reset() {",
      "\t\t${3}.value = ${4};",
      "\t}",
      "",
      "\treturn { ${3}, ${5}, ${6}, \\$reset };",
      "});",
      "",
      "if (import.meta.hot) {",
      "\timport.meta.hot.accept(acceptHMRUpdate(use${1}Store, import.meta.hot));",
      "}",
      ""
    ],
    "description": "A complete Setup Store file: state / getters / actions + HMR.\nIn Setup Stores `ref()`s are state, `computed()`s are getters and `function()`s are actions.\nEverything you return is exposed on the store.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia Setup Store - async list (full file)": {
    "prefix": ["defineStoreAsync", "dsa"],
    "body": [
      "import { computed, ref } from 'vue';",
      "import { acceptHMRUpdate, defineStore } from 'pinia';",
      "import { ${3:fetchList} } from '@/api/${2:${TM_FILENAME_BASE/^([A-Z])|(?<=[a-z0-9])([A-Z])|([-_\\s]+)/${1:/downcase}${2:+-}${2:/downcase}${3:+-}/g}}';",
      "",
      "export const use${1:${TM_FILENAME_BASE/[-_\\s]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/upcase}$2/g}}Store = defineStore('${2}', () => {",
      "\t// state",
      "\tconst list = ref([]);",
      "\tconst loading = ref(false);",
      "\tconst error = ref(null);",
      "",
      "\t// getters",
      "\tconst total = computed(() => list.value.length);",
      "\tconst isEmpty = computed(() => !loading.value && list.value.length === 0);",
      "",
      "\t// actions",
      "\tasync function load(params) {",
      "\t\tloading.value = true;",
      "\t\terror.value = null;",
      "",
      "\t\ttry {",
      "\t\t\tlist.value = await ${3}(params);",
      "\t\t} catch (err) {",
      "\t\t\terror.value = err;",
      "\t\t\tthrow err;",
      "\t\t} finally {",
      "\t\t\tloading.value = false;",
      "\t\t}",
      "\t}",
      "",
      "\tfunction \\$reset() {",
      "\t\tlist.value = [];",
      "\t\tloading.value = false;",
      "\t\terror.value = null;",
      "\t}",
      "",
      "\treturn { list, loading, error, total, isEmpty, load, \\$reset };",
      "});",
      "",
      "if (import.meta.hot) {",
      "\timport.meta.hot.accept(acceptHMRUpdate(use${1}Store, import.meta.hot));",
      "}",
      ""
    ],
    "description": "The most common real-world store: a remote list with loading / error state.\nActions are just functions, so `async` works with no extra ceremony.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia Option Store (full file)": {
    "prefix": ["defineStoreOptions", "dso"],
    "body": [
      "import { acceptHMRUpdate, defineStore } from 'pinia';",
      "",
      "export const use${1:${TM_FILENAME_BASE/[-_\\s]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/upcase}$2/g}}Store = defineStore('${2:${TM_FILENAME_BASE/^([A-Z])|(?<=[a-z0-9])([A-Z])|([-_\\s]+)/${1:/downcase}${2:+-}${2:/downcase}${3:+-}/g}}', {",
      "\tstate: () => ({",
      "\t\t${3:count}: ${4:0},",
      "\t}),",
      "",
      "\tgetters: {",
      "\t\t${5:double}: (state) => state.${3} * 2,",
      "\t},",
      "",
      "\tactions: {",
      "\t\t${6:increment}(step = 1) {",
      "\t\t\tthis.${3} += step;",
      "\t\t},",
      "\t},",
      "});",
      "",
      "if (import.meta.hot) {",
      "\timport.meta.hot.accept(acceptHMRUpdate(use${1}Store, import.meta.hot));",
      "}",
      ""
    ],
    "description": "A complete Option Store file. Think of `state` as `data`, `getters` as `computed`,\n`actions` as `methods`. Option Stores get `$reset()` for free.\nGetters that use `this` need an explicit return type in TypeScript.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia Store using another Store": {
    "prefix": ["defineStoreCompose", "dsc"],
    "body": [
      "import { computed, ref } from 'vue';",
      "import { defineStore } from 'pinia';",
      "import { use${3:User}Store } from '@/stores/${4:user}';",
      "",
      "export const use${1:${TM_FILENAME_BASE/[-_\\s]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/upcase}$2/g}}Store = defineStore('${2:${TM_FILENAME_BASE/^([A-Z])|(?<=[a-z0-9])([A-Z])|([-_\\s]+)/${1:/downcase}${2:+-}${2:/downcase}${3:+-}/g}}', () => {",
      "\t// call the other store inside the setup function, never at module top level",
      "\tconst ${4}Store = use${3}Store();",
      "",
      "\tconst items = ref([]);",
      "",
      "\tconst canSubmit = computed(",
      "\t\t() => ${4}Store.isLoggedIn && items.value.length > 0",
      "\t);",
      "",
      "\tasync function submit() {",
      "\t\tawait ${5:submitOrder}({ userId: ${4}Store.id, items: items.value });",
      "\t}",
      "",
      "\treturn { items, canSubmit, submit };",
      "});",
      ""
    ],
    "description": "Compose stores by calling one inside another.\nCall `useOtherStore()` inside the setup function (or inside an action for Option Stores),\nnot at module top level - the pinia instance may not be active yet.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia Store in a form": {
    "prefix": ["defineStoreForm", "dsf"],
    "body": [
      "import { defineStore } from 'pinia';",
      "",
      "const initialState = () => ({",
      "\t${3:name}: '',",
      "\t${4:email}: '',",
      "});",
      "",
      "export const use${1:${TM_FILENAME_BASE/[-_\\s]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/upcase}$2/g}}Store = defineStore('${2:${TM_FILENAME_BASE/^([A-Z])|(?<=[a-z0-9])([A-Z])|([-_\\s]+)/${1:/downcase}${2:+-}${2:/downcase}${3:+-}/g}}', {",
      "\tstate: initialState,",
      "",
      "\tactions: {",
      "\t\tasync submit() {",
      "\t\t\tawait ${5:save}(this.\\$state);",
      "\t\t\tthis.\\$reset();",
      "\t\t},",
      "\t},",
      "});",
      ""
    ],
    "description": "Form state in a store. Use an Option Store so `$reset()` works out of the box,\nand bind fields with `mapWritableState()` (Options API) or `storeToRefs()` (Composition API).\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia in a component (script setup)": {
    "prefix": "useStore",
    "body": [
      "import { onMounted } from 'vue';",
      "import { storeToRefs } from 'pinia';",
      "import { use${1:User}Store } from '@/stores/${2:user}';",
      "",
      "const ${2}Store = use${1}Store();",
      "",
      "// state and getters need storeToRefs() to stay reactive when destructured",
      "const { ${3:list, loading} } = storeToRefs(${2}Store);",
      "",
      "// actions can be destructured directly",
      "const { ${4:load} } = ${2}Store;",
      "",
      "onMounted(() => {",
      "\t${4}();",
      "});"
    ],
    "description": "Use a store inside `<script setup>`.\nDestructuring the store directly breaks reactivity for state and getters -\nthat is what `storeToRefs()` is for. Actions are plain functions and can be destructured.\n",
    "scope": "vue,javascript,typescript"
  },
  "Pinia in a component (Options API)": {
    "prefix": ["useStoreOptions", "uso"],
    "body": [
      "import { mapActions, mapState } from 'pinia';",
      "import { use${1:User}Store } from '@/stores/${2:user}';",
      "",
      "export default {",
      "\tcomputed: {",
      "\t\t...mapState(use${1}Store, ['${3:list}', '${4:loading}']),",
      "\t},",
      "",
      "\tmethods: {",
      "\t\t...mapActions(use${1}Store, ['${5:load}']),",
      "\t},",
      "",
      "\tmounted() {",
      "\t\tthis.${5}();",
      "\t},",
      "};"
    ],
    "description": "Use a store from the Options API without `setup()`.\n`mapState()` maps state and getters as readonly computed, `mapActions()` maps actions as methods.\nUse `mapWritableState()` when you need to assign (e.g. `v-model`).\n",
    "scope": "vue,javascript,typescript"
  },
  "Pinia outside a component (router guard)": {
    "prefix": ["useStoreOutside", "pout"],
    "body": [
      "import { use${1:User}Store } from '@/stores/${2:user}';",
      "",
      "// Call the store *inside* the callback, not at module top level:",
      "// the pinia instance must be active by then.",
      "${3:router}.beforeEach((to) => {",
      "\tconst ${2}Store = use${1}Store();",
      "",
      "\tif (to.meta.requiresAuth && !${2}Store.isLoggedIn) {",
      "\t\treturn { name: '${4:login}' };",
      "\t}",
      "});"
    ],
    "description": "Use a store outside of components (router guards, http interceptors, plain modules).\nIf there is no app yet (scripts, tests), call `setActivePinia(createPinia())` first.\n",
    "scope": "javascript,typescript"
  },
  "Pinia persist state to localStorage": {
    "prefix": ["piniaPersist", "pper"],
    "body": [
      "const ${2:user}Store = use${1:User}Store();",
      "const storageKey = '${3:store}:${2}';",
      "",
      "// restore",
      "const cached = localStorage.getItem(storageKey);",
      "if (cached) {",
      "\t${2}Store.\\$patch(JSON.parse(cached));",
      "}",
      "",
      "// persist on every change",
      "${2}Store.\\$subscribe(",
      "\t(mutation, state) => {",
      "\t\tlocalStorage.setItem(storageKey, JSON.stringify(state));",
      "\t},",
      "\t{ detached: true }",
      ");"
    ],
    "description": "Persist a single store to localStorage.\n`detached: true` keeps the subscription alive after the component unmounts.\nFor all stores at once, write a pinia plugin instead (`piniaPlugin`).\n",
    "scope": "vue,javascript,typescript"
  },
  "Pinia Plugin - persist every store": {
    "prefix": ["piniaPlugin", "pplugin"],
    "body": [
      "import { toRaw } from 'vue';",
      "",
      "// usage: pinia.use(${1:persistPlugin})",
      "// opt in per store: defineStore(id, setup, { persist: true })",
      "export function ${1:persistPlugin}({ store, options }) {",
      "\tif (!options.persist) return;",
      "",
      "\tconst storageKey = `pinia:\\${store.\\$id}`;",
      "\tconst cached = localStorage.getItem(storageKey);",
      "",
      "\tif (cached) {",
      "\t\tstore.\\$patch(JSON.parse(cached));",
      "\t}",
      "",
      "\tstore.\\$subscribe(",
      "\t\t(mutation, state) => {",
      "\t\t\tlocalStorage.setItem(storageKey, JSON.stringify(toRaw(state)));",
      "\t\t},",
      "\t\t{ detached: true }",
      "\t);",
      "}"
    ],
    "description": "A pinia plugin runs for every store. Whatever it returns is added to each store.\nThe argument is a `PiniaPluginContext` ({ store, options, app, pinia }).\nRegister it with `pinia.use(plugin)` before `app.use(pinia)`.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia Plugin - log every action": {
    "prefix": ["piniaOnAction", "plog"],
    "body": [
      "${1:pinia}.use(({ store }) => {",
      "\tstore.\\$onAction(({ name, args, after, onError }) => {",
      "\t\tconst startedAt = Date.now();",
      "",
      "\t\tafter((result) => {",
      "\t\t\tconsole.log(",
      "\t\t\t\t`[\\${store.\\$id}] \\${name} took \\${Date.now() - startedAt}ms`",
      "\t\t\t);",
      "\t\t});",
      "",
      "\t\tonError((error) => {",
      "\t\t\tconsole.error(`[\\${store.\\$id}] \\${name} failed`, error);",
      "\t\t});",
      "\t});",
      "});"
    ],
    "description": "Central logging / error reporting for every action in every store.\n`after()` runs on success (and receives the resolved value), `onError()` on throw or rejection.\nReturn nothing from `onError` to let the error propagate.\n",
    "scope": "javascript,typescript"
  },
  "Pinia store unit test": {
    "prefix": ["piniaTest", "ptest"],
    "body": [
      "import { beforeEach, describe, expect, it } from 'vitest';",
      "import { createPinia, setActivePinia } from 'pinia';",
      "import { use${1:Counter}Store } from '@/stores/${2:counter}';",
      "",
      "describe('${2} store', () => {",
      "\tbeforeEach(() => {",
      "\t\t// a fresh pinia for every test",
      "\t\tsetActivePinia(createPinia());",
      "\t});",
      "",
      "\tit('${3:increments}', () => {",
      "\t\tconst store = use${1}Store();",
      "",
      "\t\t$4",
      "\t});",
      "});",
      ""
    ],
    "description": "Unit test a store in isolation. `setActivePinia(createPinia())` in `beforeEach`\ngives each test a clean store, and lets you call `useStore()` outside a component.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia component test (createTestingPinia)": {
    "prefix": ["piniaTestComponent", "ptestc"],
    "body": [
      "import { describe, expect, it, vi } from 'vitest';",
      "import { mount } from '@vue/test-utils';",
      "import { createTestingPinia } from '@pinia/testing';",
      "import { use${1:Counter}Store } from '@/stores/${2:counter}';",
      "",
      "describe('${3:Component}', () => {",
      "\tit('${4:calls the action}', async () => {",
      "\t\tconst wrapper = mount(${3}, {",
      "\t\t\tglobal: {",
      "\t\t\t\tplugins: [createTestingPinia({ createSpy: vi.fn })],",
      "\t\t\t},",
      "\t\t});",
      "",
      "\t\tconst store = use${1}Store();",
      "",
      "\t\t// state can be written directly",
      "\t\tstore.${5:count} = 10;",
      "\t\tawait wrapper.vm.\\$nextTick();",
      "",
      "\t\t$6",
      "\t});",
      "});",
      ""
    ],
    "description": "Test a component with stubbed stores. `createTestingPinia()` stubs every action\nso you can assert it was called without running it. Pass `stubActions: false` to run them.\nRequires `@pinia/testing`.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  },
  "Pinia SSR store": {
    "prefix": ["piniaSSR", "pssr"],
    "body": [
      "import { ref } from 'vue';",
      "import { defineStore, skipHydrate } from 'pinia';",
      "",
      "export const use${1:${TM_FILENAME_BASE/[-_\\s]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/upcase}$2/g}}Store = defineStore('${2:${TM_FILENAME_BASE/^([A-Z])|(?<=[a-z0-9])([A-Z])|([-_\\s]+)/${1:/downcase}${2:+-}${2:/downcase}${3:+-}/g}}', () => {",
      "\tconst ${3:data} = ref(null);",
      "",
      "\t// browser-only state: do not overwrite it with the server payload",
      "\tconst ${4:localOnly} = skipHydrate(ref(null));",
      "",
      "\treturn { ${3}, ${4} };",
      "});",
      "",
      "// server: serialize with `pinia.state.value`",
      "// client: rehydrate with `pinia.state.value = JSON.parse(payload)` before mounting",
      ""
    ],
    "description": "SSR: state is serialized from `pinia.state.value` on the server and assigned back on the client.\nWrap browser-only state in `skipHydrate()` so hydration leaves it alone.\n",
    "scope": "javascript,typescript",
    "isFileTemplate": true
  }
}
