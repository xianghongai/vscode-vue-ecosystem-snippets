			"    <span v-if=\"errors.${3}\" role=\"alert\">{{ errors.${3} }}</span>",
			"    $0",
			"    <button type=\"submit\" :disabled=\"isPending\">${7:Save}</button>",
			"  </form>",
			"</template>"
