			"});",
			"",
			"const onSubmit = handleSubmit(async (values) => {",
			"  try {",
			"    await mutateAsync(values);",
			"  } catch {",
			"    setErrors({ ${3}: '${5:Could not save. Try again.}' });",
			"  }",
			"});",
			"</script>",
			"",
			"<template>",
